+static void ggml_compute_forward_mul_mat_id_weighted_reduce(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0    = dst->src[0];
+    const struct ggml_tensor * src1    = dst->src[1];
+    const struct ggml_tensor * ids     = dst->src[2];
+    const struct ggml_tensor * weights = dst->src[3];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const enum ggml_type type = src0->type;
+    const enum ggml_type vec_dot_type = type_traits_cpu[type].vec_dot_type;
+    const ggml_from_float_t from_float = type_traits_cpu[vec_dot_type].from_float;
+    const ggml_vec_dot_t vec_dot = type_traits_cpu[type].vec_dot;
+
+    GGML_ASSERT(from_float);
+    GGML_ASSERT(vec_dot);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0->ne[0] == src1->ne[0]);
+    GGML_ASSERT(ids->ne[0] == src1->ne[1]);
+    GGML_ASSERT(ids->ne[1] == src1->ne[2]);
+    GGML_ASSERT(weights->ne[0] == 1);
+    GGML_ASSERT(weights->ne[1] == ids->ne[0]);
+    GGML_ASSERT(weights->ne[2] == ids->ne[1]);
+    GGML_ASSERT(ggml_is_contiguous(src0));
+    GGML_ASSERT(ggml_is_contiguous(src1));
+    GGML_ASSERT(ggml_is_contiguous(ids));
+    GGML_ASSERT(ggml_is_contiguous(weights));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+
+    const int64_t ncols = src0->ne[0];
+    const int64_t nrows = src0->ne[1];
+    const int64_t n_expert = src0->ne[2];
+    const int64_t n_expert_used = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+
+    const int64_t quant_block_size = ggml_blck_size(vec_dot_type);
+    const size_t quant_type_size = ggml_type_size(vec_dot_type);
+    const size_t quant_row_size = ggml_row_size(vec_dot_type, ncols);
+    char * src1_quantized = params->wdata;
+
+    GGML_ASSERT(src1_quantized);
+    GGML_ASSERT(params->wsize >= quant_row_size * n_expert_used * n_tokens);
+
+    const int64_t blocks_per_row = ncols / quant_block_size;
+    const int64_t block_start = (ith * blocks_per_row) / nth;
+    const int64_t block_end = ((ith + 1) * blocks_per_row) / nth;
+    if (block_start < block_end) {
+        for (int64_t token = 0; token < n_tokens; ++token) {
+            for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+                const float * src_row = (const float *) (
+                    (const char *) src1->data + token * src1->nb[2] + expert * src1->nb[1]);
+                char * quant_row =
+                    src1_quantized + (token * n_expert_used + expert) * quant_row_size;
+                from_float(
+                    src_row + block_start * quant_block_size,
+                    quant_row + block_start * quant_type_size,
+                    (block_end - block_start) * quant_block_size);
+            }
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    for (int64_t token = 0; token < n_tokens; ++token) {
+        for (int64_t row = ith; row < nrows; row += nth) {
+            float sum = 0.0f;
+            for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+                const int32_t expert_id = *(const int32_t *) (
+                    (const char *) ids->data + token * ids->nb[1] + expert * ids->nb[0]);
+                GGML_ASSERT(expert_id >= 0 && expert_id < n_expert);
+
+                const char * weight_row =
+                    (const char *) src0->data + expert_id * src0->nb[2] + row * src0->nb[1];
+                const char * activated_row =
+                    src1_quantized + (token * n_expert_used + expert) * quant_row_size;
+                const float router_weight = *(const float *) (
+                    (const char *) weights->data + token * weights->nb[2] + expert * weights->nb[1]);
+
+                float dot = 0.0f;
+                vec_dot(ncols, &dot, 0, weight_row, 0, activated_row, 0, 1);
+                sum += router_weight * dot;
+            }
+            *(float *) ((char *) dst->data + token * dst->nb[1] + row * dst->nb[0]) = sum;
+        }
+    }
+}
