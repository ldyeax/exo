+        };
+
+        if (ggml_tensor * ids = ggml_get_tensor(ctx, "down_ids_storage")) {
+            std::vector<int32_t> ids_data(n_expert, 0);
+            std::copy(selected_ids.begin(), selected_ids.end(), ids_data.begin());
+            ggml_backend_tensor_set(ids, ids_data.data(), 0, ids_data.size() * sizeof(int32_t));
+        }
+
+        if (ggml_tensor * activated = ggml_get_tensor(ctx, "down_activated")) {
+            std::vector<float> values(n_ff * n_expert_used);
+            for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+                for (int64_t col = 0; col < n_ff; ++col) {
+                    values[expert * n_ff + col] =
+                        0.375f * sinf(float(col) * 0.013671875f + float(expert) * 0.1875f) +
+                        0.125f * cosf(float(col) * 0.005859375f - float(expert) * 0.09375f);
+                }
+            }
+            ggml_backend_tensor_set(activated, values.data(), 0, values.size() * sizeof(float));
+        }
+
+        if (ggml_tensor * router_weights = ggml_get_tensor(ctx, "down_router_weights")) {
+            std::array<float, n_expert_used> values;
+            constexpr float denominator = float(n_expert_used * (n_expert_used + 1) / 2);
+            for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+                values[expert] = float(expert + 1) / denominator;
+            }
+            ggml_backend_tensor_set(
+                router_weights, values.data(), 0, values.size() * sizeof(float));
+        }
+
+        ggml_tensor * down_weights = ggml_get_tensor(ctx, "down_weights");
+        if (!down_weights) {
+            return;
+        }
+
+        std::vector<float> matrix(n_ff * n_embd);
+        for (int64_t row = 0; row < n_embd; ++row) {
+            for (int64_t col = 0; col < n_ff; ++col) {
+                matrix[row * n_ff + col] =
+                    0.109375f * sinf(float(col) * 0.009765625f + float(row) * 0.00390625f) +
+                    0.046875f * cosf(float(col) * 0.00341796875f - float(row) * 0.0078125f);
+            }
+        }
+
+        std::vector<float> imatrix(n_ff, 1.0f);
+        const size_t row_size = ggml_row_size(weight_type, n_ff);
+        const size_t expert_size = row_size * n_embd;
+        std::vector<uint8_t> base_quantized(expert_size);
+        std::vector<uint8_t> expert_quantized(expert_size);
