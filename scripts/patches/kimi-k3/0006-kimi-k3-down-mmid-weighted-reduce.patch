+struct test_kimi_k3_down_mmid_reduce : public test_case {
+    static constexpr int64_t n_embd       = 3584;
+    static constexpr int64_t n_ff         = 3072;
+    static constexpr int64_t n_expert     = 896;
+    static constexpr int64_t n_expert_used = 16;
+
+    const ggml_type weight_type;
+    const bool fused;
+
+    ggml_tensor * weighted_experts = nullptr;
+    std::vector<ggml_tensor *> expert_views;
+    std::vector<ggml_tensor *> expert_sums;
+
+    explicit test_kimi_k3_down_mmid_reduce(ggml_type weight_type, bool fused = false)
+        : weight_type(weight_type), fused(fused) {}
+
+    std::string vars() override {
+        return VARS_TO_STR2(weight_type, fused);
+    }
+
+    double max_nmse_err() override {
+        return 2e-3;
+    }
+
+    uint64_t op_flops(ggml_tensor * tensor) override {
+        GGML_UNUSED(tensor);
+        return 2ULL * n_embd * n_ff * n_expert_used;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        return build_graph(ctx, ctx);
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx, ggml_context * ctx_weights) override {
+        GGML_ASSERT(ctx_weights);
+
+        weighted_experts = nullptr;
+        expert_views.clear();
+        expert_sums.clear();
+
+        ggml_tensor * down_weights =
+            ggml_new_tensor_3d(ctx_weights, weight_type, n_ff, n_embd, n_expert);
+        ggml_set_name(down_weights, "down_weights");
+
+        ggml_tensor * ids_storage = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_expert, 1);
+        ggml_set_name(ids_storage, "down_ids_storage");
+        ggml_tensor * ids =
+            ggml_view_2d(ctx, ids_storage, n_expert_used, 1, ids_storage->nb[1], 0);
+        ggml_set_name(ids, "down_ids");
+
+        ggml_tensor * activated =
+            ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_ff, n_expert_used, 1);
+        ggml_set_name(activated, "down_activated");
+
+        ggml_tensor * router_weights =
+            ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_expert_used, 1);
+        ggml_set_name(router_weights, "down_router_weights");
+
+        if (fused) {
+            ggml_tensor * out =
+                ggml_mul_mat_id_weighted_reduce(ctx, down_weights, activated, ids, router_weights);
+            ggml_set_name(out, "down_fused_out");
+            return out;
+        }
+
+        ggml_tensor * experts = ggml_mul_mat_id(ctx, down_weights, activated, ids);
+        ggml_set_name(experts, "down_experts");
+
+        weighted_experts = ggml_mul(ctx, experts, router_weights);
+        ggml_set_name(weighted_experts, "down_weighted_experts");
+
+        expert_views.reserve(n_expert_used);
+        for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+            ggml_tensor * view = ggml_view_2d(
+                ctx, weighted_experts, n_embd, 1, weighted_experts->nb[2],
+                expert * weighted_experts->nb[1]);
+            ggml_set_name(view, "down_expert_view");
+            expert_views.push_back(view);
+        }
+
+        ggml_tensor * out = expert_views[0];
+        expert_sums.reserve(n_expert_used - 1);
+        for (int64_t expert = 1; expert < n_expert_used; ++expert) {
+            out = ggml_add(ctx, out, expert_views[expert]);
+            ggml_set_name(out, "down_expert_sum");
+            expert_sums.push_back(out);
+        }
+        ggml_set_name(out, "down_out");
+        return out;
+    }
+
+    void build_forward_expand(ggml_cgraph * graph, ggml_tensor * out) override {
+        if (fused) {
+            test_case::build_forward_expand(graph, out);
+            return;
+        }
+        GGML_ASSERT(weighted_experts && !expert_views.empty() && !expert_sums.empty());
+        ggml_build_forward_expand(graph, weighted_experts);
+        for (ggml_tensor * view : expert_views) {
+            ggml_build_forward_expand(graph, view);
+        }
+        for (ggml_tensor * sum : expert_sums) {
+            ggml_build_forward_expand(graph, sum);
+        }
+        GGML_ASSERT(expert_sums.back() == out);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        static constexpr std::array<int32_t, n_expert_used> selected_ids = {
