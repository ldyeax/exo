+            weight_type, matrix.data(), base_quantized.data(), 0, n_embd, n_ff, imatrix.data());
+        GGML_ASSERT(quantized_size == expert_size);
+
+        for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+            const int64_t row_shift = (expert * 223) % n_embd;
+            for (int64_t row = 0; row < n_embd; ++row) {
+                const int64_t source_row = (row + row_shift) % n_embd;
+                memcpy(
+                    expert_quantized.data() + row * row_size,
+                    base_quantized.data() + source_row * row_size,
+                    row_size);
+            }
+            ggml_backend_tensor_set(
+                down_weights, expert_quantized.data(),
+                selected_ids[expert] * down_weights->nb[2], expert_quantized.size());
+        }
+    }
