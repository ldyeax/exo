+void ggml_cuda_mul_mat_id_weighted_reduce(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        const ggml_tensor * ids, const ggml_tensor * weights, ggml_tensor * dst) {
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0->ne[0] == 3072 && src0->ne[1] == 3584 && src0->ne[2] == 896);
+    GGML_ASSERT(src1->ne[0] == 3072 && src1->ne[1] == 16 && src1->ne[2] == 1);
+    GGML_ASSERT(ids->ne[0] == 16 && ids->ne[1] == 1);
+    GGML_ASSERT(weights->ne[0] == 1 && weights->ne[1] == 16 && weights->ne[2] == 1);
+    GGML_ASSERT(dst->ne[0] == 3584 && dst->ne[1] == 1);
+    GGML_ASSERT(ggml_is_contiguous(src0));
+    GGML_ASSERT(ggml_is_contiguous(src1));
+    GGML_ASSERT(ggml_is_contiguous(ids));
+    GGML_ASSERT(ggml_is_contiguous(weights));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+
+    cudaStream_t stream = ctx.stream();
+
+    const size_t ts_src0 = ggml_type_size(src0->type);
+    const size_t ts_src1 = ggml_type_size(src1->type);
+    const size_t ts_weights = ggml_type_size(weights->type);
+
+    const int64_t ncols_padded = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<char> src1_q8_1(
+        ctx.pool(), src1->ne[2] * src1->ne[1] * ncols_padded * sizeof(block_q8_1) / QK8_1);
+    quantize_row_q8_1_cuda(
+        (const float *) src1->data, nullptr, src1_q8_1.get(), src0->type,
+        src1->ne[0], src1->nb[1] / ts_src1, src1->nb[2] / ts_src1, src1->nb[3] / ts_src1,
+        ncols_padded, src1->ne[1], src1->ne[2], src1->ne[3], stream);
+
+    const uint32_t stride_row_x = src0->nb[1] / ts_src0;
+    const uint32_t stride_channel_x = src0->nb[2] / ts_src0;
+    const uint32_t stride_channel_y = ncols_padded / QK8_1;
+    const uint32_t stride_weight = weights->nb[1] / ts_weights;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+#define GGML_CUDA_LAUNCH_KIMI_K3_DOWN(TYPE)                                                   \
+    do {                                                                                       \
+        mul_mat_vec_q_moe_weighted_reduce_launch<TYPE, 4, 2>(                                 \
+            src0->data, src1_q8_1.get(), (const int32_t *) ids->data,                          \
+            (const float *) weights->data, (float *) dst->data,                                \
+            src0->ne[0], src0->ne[1], stride_row_x, stride_channel_x,                          \
+            stride_channel_y, stride_weight, warp_size, stream);                               \
+    } while (0)
+
+    switch (src0->type) {
+        case GGML_TYPE_IQ1_M:
+            GGML_CUDA_LAUNCH_KIMI_K3_DOWN(GGML_TYPE_IQ1_M);
+            break;
+        case GGML_TYPE_IQ2_XS:
+            GGML_CUDA_LAUNCH_KIMI_K3_DOWN(GGML_TYPE_IQ2_XS);
+            break;
+        case GGML_TYPE_IQ3_XXS:
+            GGML_CUDA_LAUNCH_KIMI_K3_DOWN(GGML_TYPE_IQ3_XXS);
+            break;
+        default:
+            GGML_ABORT("unsupported Kimi K3 down projection type");
+    }
+
+#undef GGML_CUDA_LAUNCH_KIMI_K3_DOWN
+}
