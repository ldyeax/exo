+__launch_bounds__(c_nwarps*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_moe_weighted_reduce(
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr,
+        const float * weights_ptr, float * dst_ptr,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y,
+        const uint32_t stride_weight) {
+    const void    * GGML_CUDA_RESTRICT vx      = vx_ptr;
+    const void    * GGML_CUDA_RESTRICT vy      = vy_ptr;
+    const int32_t * GGML_CUDA_RESTRICT ids     = ids_ptr;
+    const float   * GGML_CUDA_RESTRICT weights = weights_ptr;
+    float         * GGML_CUDA_RESTRICT dst     = dst_ptr;
+
+    constexpr int qk        = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi        = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr       = get_vdr_mmvq(type);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    __shared__ float contributions[c_n_expert_used][c_rows_per_block];
+
+    const int row0 = c_rows_per_block * blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+
+    ggml_cuda_pdl_sync();
+
+    for (int expert = threadIdx.y; expert < c_n_expert_used; expert += c_nwarps) {
+        const uint32_t channel_x = ids[expert];
+        const block_q8_1 * y = ((const block_q8_1 *) vy) + expert * stride_channel_y;
+        const int kbx_offset = channel_x * stride_channel_x + row0 * stride_row_x;
+
+        float dot[c_rows_per_block] = { 0.0f };
+        for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (qk/QK8_1);
+            const int kqs = vdr * (threadIdx.x % (qi/vdr));
+#pragma unroll
+            for (int row = 0; row < c_rows_per_block; ++row) {
+                dot[row] += vec_dot_q_cuda(
+                    vx, &y[kby], kbx_offset + row * stride_row_x + kbx, kqs);
+            }
+        }
+
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+            dot[row] = warp_reduce_sum<warp_size>(dot[row]);
+        }
+        if (threadIdx.x == 0) {
+#pragma unroll
+            for (int row = 0; row < c_rows_per_block; ++row) {
+                if (row0 + row < nrows_x) {
+                    contributions[expert][row] = dot[row];
+                }
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+    __syncthreads();
+
+    if (threadIdx.y == 0 && threadIdx.x == 0) {
+        for (int row = 0; row < c_rows_per_block && row0 + row < nrows_x; ++row) {
+            float sum = __fmul_rn(weights[0], contributions[0][row]);
+#pragma unroll 1
+            for (int i = 1; i < c_n_expert_used; ++i) {
+                sum = __fadd_rn(
+                    sum, __fmul_rn(weights[i * stride_weight], contributions[i][row]));
+            }
+            dst[row0 + row] = sum;
+        }
+    }
+}
