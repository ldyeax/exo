+bool llama_model_loader::enqueue_rpc_tensor_source(
+        struct ggml_tensor * tensor,
+        const llama_tensor_weight & weight) {
+    if (check_tensors ||
+        weight.idx >= rpc_tensor_source_paths.size() ||
+        rpc_tensor_source_paths[weight.idx].empty() ||
+        unavailable_rpc_tensor_source_buffers.count(tensor->buffer) != 0) {
+        return false;
+    }
+
+    rpc_tensor_set_from_file_t set_from_file =
+        rpc_tensor_set_from_file(tensor->buffer);
+    if (set_from_file == nullptr) {
+        return false;
+    }
+
+    const size_t size = ggml_nbytes(tensor);
+    const bool queued = set_from_file(
+        tensor,
+        rpc_tensor_source_paths[weight.idx].c_str(),
+        weight.offs,
+        0,
+        size);
+    if (queued) {
+        pending_rpc_tensor_source_buffers.insert(tensor->buffer);
+        rpc_tensor_source_count++;
+        rpc_tensor_source_bytes += size;
+        return true;
+    }
+    if (pending_rpc_tensor_source_buffers.count(tensor->buffer) != 0) {
+        throw std::runtime_error(format(
+            "RPC tensor source rejected '%s' after accepting earlier tensors",
+            rpc_tensor_source_paths[weight.idx].c_str()));
+    }
+    unavailable_rpc_tensor_source_buffers.insert(tensor->buffer);
+    LLAMA_LOG_WARN(
+        "%s: RPC server did not admit its local tensor source; falling back to client reads\n",
+        __func__);
+    return false;
+}
