diff --git a/tests/test-backend-sched-shared-tensors.cpp b/tests/test-backend-sched-shared-tensors.cpp
new file mode 100644
index 000000000..469323fc2
--- /dev/null
+++ b/tests/test-backend-sched-shared-tensors.cpp
@@ -0,0 +1,136 @@
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "ggml.h"
+
+#undef NDEBUG
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+static ggml_context_ptr make_context(size_t n_tensors, size_t n_nodes = 0) {
+    const ggml_init_params params = {
+        /* .mem_size   = */ n_tensors * ggml_tensor_overhead() +
+                           (n_nodes == 0 ? 0 : ggml_graph_overhead_custom(n_nodes, false)),
+        /* .mem_buffer = */ nullptr,
+        /* .no_alloc   = */ true,
+    };
+    return ggml_context_ptr(ggml_init(params));
+}
+
+int main() {
+    ggml_backend_load_all();
+
+    ggml_backend_dev_t cpu_device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    assert(cpu_device != nullptr);
+
+    ggml_backend_ptr cpu_backend(ggml_backend_dev_init(cpu_device, nullptr));
+    assert(cpu_backend != nullptr);
+
+    constexpr int64_t n_embd   = 8;
+    constexpr int64_t n_vocab  = 16;
+    constexpr int64_t n_tokens = 2;
+    constexpr size_t  n_nodes  = 32;
+
+    auto weight_context = make_context(2);
+    assert(weight_context != nullptr);
+    ggml_tensor * token_embedding = ggml_new_tensor_2d(
+            weight_context.get(), GGML_TYPE_F32, n_embd, n_vocab);
+    ggml_set_name(token_embedding, "target.token_embd.weight");
+    ggml_tensor * output = ggml_new_tensor_2d(
+            weight_context.get(), GGML_TYPE_F32, n_embd, n_vocab);
+    ggml_set_name(output, "target.output.weight");
+
+    auto graph_context = make_context(8, n_nodes);
+    assert(graph_context != nullptr);
+    ggml_tensor * tokens = ggml_new_tensor_1d(
+            graph_context.get(), GGML_TYPE_I32, n_tokens);
+    ggml_set_name(tokens, "draft.tokens");
+    ggml_set_input(tokens);
+
+    ggml_tensor * hidden = ggml_get_rows(graph_context.get(), token_embedding, tokens);
+    ggml_set_name(hidden, "draft.hidden");
+    ggml_tensor * logits = ggml_mul_mat(graph_context.get(), output, hidden);
+    ggml_set_name(logits, "draft.logits");
+    ggml_set_output(logits);
+
+    ggml_cgraph * graph = ggml_new_graph_custom(graph_context.get(), n_nodes, false);
+    ggml_build_forward_expand(graph, logits);
+
+    ggml_backend_ptr target_backend;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t device = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+
+        ggml_backend_ptr candidate(ggml_backend_dev_init(device, nullptr));
+        if (candidate != nullptr &&
+            ggml_backend_supports_op(candidate.get(), hidden) &&
+            ggml_backend_supports_op(candidate.get(), logits)) {
+            target_backend = std::move(candidate);
+            break;
+        }
+    }
+
+    if (target_backend == nullptr) {
+        std::puts("SKIP: no non-CPU backend supports GET_ROWS and MUL_MAT");
+        return 0;
+    }
+
+    ggml_backend_buffer_ptr weights(
+            ggml_backend_alloc_ctx_tensors(weight_context.get(), target_backend.get()));
+    assert(weights != nullptr);
+    ggml_backend_buffer_set_usage(weights.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::vector<float> embedding_data(n_embd * n_vocab);
+    std::vector<float> output_data(n_embd * n_vocab);
+    for (int64_t row = 0; row < n_vocab; ++row) {
+        for (int64_t column = 0; column < n_embd; ++column) {
+            embedding_data[row * n_embd + column] = 0.01f * float(1 + row * n_embd + column);
+            output_data[row * n_embd + column] =
+                    0.005f * float(1 + ((row + 3) % n_vocab) * n_embd + column);
+        }
+    }
+    ggml_backend_tensor_set(
+            token_embedding, embedding_data.data(), 0, embedding_data.size() * sizeof(float));
+    ggml_backend_tensor_set(output, output_data.data(), 0, output_data.size() * sizeof(float));
+
+    // The target backend is non-owning from the draft scheduler's point of
+    // view, exactly like a backend borrowed from ctx_other. Its presence lets
+    // immutable target weights remain in their original buffers while graph
+    // inputs and draft-owned work still have the CPU fallback.
+    ggml_backend_t scheduler_backends[] = {
+        target_backend.get(),
+        cpu_backend.get(),
+    };
+    ggml_backend_sched_ptr scheduler(ggml_backend_sched_new(
+            scheduler_backends, nullptr, 2, n_nodes, false, true));
+    assert(scheduler != nullptr);
+    assert(ggml_backend_sched_reserve(scheduler.get(), graph));
+    assert(ggml_backend_sched_alloc_graph(scheduler.get(), graph));
+
+    const std::vector<int32_t> token_data = { 2, 11 };
+    ggml_backend_tensor_set(tokens, token_data.data(), 0, token_data.size() * sizeof(int32_t));
+    assert(ggml_backend_sched_graph_compute(scheduler.get(), graph) == GGML_STATUS_SUCCESS);
+
+    std::vector<float> actual(n_vocab * n_tokens);
+    ggml_backend_tensor_get(logits, actual.data(), 0, actual.size() * sizeof(float));
+
+    for (int64_t token_index = 0; token_index < n_tokens; ++token_index) {
+        const int32_t token = token_data[token_index];
+        for (int64_t vocab_index = 0; vocab_index < n_vocab; ++vocab_index) {
+            float expected = 0.0f;
+            for (int64_t column = 0; column < n_embd; ++column) {
+                expected += output_data[vocab_index * n_embd + column] *
+                            embedding_data[token * n_embd + column];
+            }
+            const float observed = actual[token_index * n_vocab + vocab_index];
+            assert(std::fabs(observed - expected) < 1e-4f);
+        }
+    }
+
+    std::printf("PASS: shared token embedding and output projection on %s\n",
+            ggml_backend_name(target_backend.get()));
+    return 0;
+}
