+                        tensors_other.emplace_back(model_other.tok_embd, "token embeddings");
+                    }
+                    if (model.output == nullptr) {
+                        tensors_other.emplace_back(model_other.output, "output projection");
+                    }
+                    break;
+                default:
+                    break;
+            }
+
+            const auto supports_tensor_buffer = [](ggml_backend_t backend, const ggml_tensor * tensor) {
+                const ggml_tensor * root = tensor;
+                while (root != nullptr && root->buffer == nullptr && root->view_src != nullptr) {
+                    root = root->view_src;
+                }
+                if (root == nullptr || root->buffer == nullptr) {
+                    return false;
