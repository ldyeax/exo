+
+            for (const auto & [tensor, role] : tensors_other) {
+                if (tensor == nullptr) {
+                    throw std::runtime_error(format("%s requires ctx_other %s", model.arch_name().c_str(), role));
+                }
+
+                const ggml_tensor * root = tensor;
+                while (root->buffer == nullptr && root->view_src != nullptr) {
+                    root = root->view_src;
+                }
+                if (root->buffer == nullptr) {
+                    // no_alloc/model-fitting contexts do not have a fixed
+                    // buffer to make visible to the scheduler
+                    continue;
+                }
+
+                const auto already_visible = [&](ggml_backend_t backend) {
+                    return supports_tensor_buffer(backend, tensor);
+                };
+                if (std::any_of(backends.begin(), backends.end(),
+                                [&](const ggml_backend_ptr & backend) { return already_visible(backend.get()); }) ||
+                    std::any_of(borrowed_backends.begin(), borrowed_backends.end(), already_visible)) {
+                    continue;
+                }
+
+                const auto & other_backends = cparams.ctx_other->backend_ptrs;
+                const auto it = std::find_if(other_backends.begin(), other_backends.end(), already_visible);
+                if (it == other_backends.end()) {
+                    throw std::runtime_error(format(
+                            "%s cannot access ctx_other %s tensor '%s' in buffer '%s'",
