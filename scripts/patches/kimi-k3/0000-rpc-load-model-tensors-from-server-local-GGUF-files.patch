+bool ggml_backend_rpc_tensor_set_from_file(
+        ggml_tensor * tensor,
+        const char * relative_path,
+        uint64_t file_offset,
+        size_t tensor_offset,
+        size_t size) {
+    if (tensor == nullptr || tensor->buffer == nullptr || relative_path == nullptr ||
+        !ggml_backend_buffer_is_rpc(tensor->buffer)) {
+        return false;
+    }
+    const size_t path_size = strlen(relative_path);
+    if (path_size == 0 || path_size > UINT32_MAX) {
+        return false;
+    }
+
+    rpc_msg_set_tensor_file_req request = {
+        /* .tensor        = */ serialize_tensor(tensor),
+        /* .tensor_offset = */ tensor_offset,
+        /* .file_offset   = */ file_offset,
+        /* .size          = */ size,
+        /* .path_size     = */ (uint32_t) path_size,
+    };
+    std::vector<uint8_t> input(sizeof(request) + path_size);
+    memcpy(input.data(), &request, sizeof(request));
+    memcpy(input.data() + sizeof(request), relative_path, path_size);
+
+    ggml_backend_rpc_buffer_context * ctx =
+        (ggml_backend_rpc_buffer_context *) tensor->buffer->context;
+    rpc_msg_set_tensor_file_rsp response = {};
+    bool status = send_rpc_cmd(
+        ctx->sock,
+        RPC_CMD_SET_TENSOR_FILE,
+        input.data(),
+        input.size(),
+        &response,
+        sizeof(response));
+    RPC_STATUS_ASSERT(status);
+    return response.result != 0;
+}
+
+bool ggml_backend_rpc_synchronize_tensor_files(ggml_backend_buffer_t buffer) {
+    if (!ggml_backend_buffer_is_rpc(buffer)) {
+        return false;
+    }
+    ggml_backend_rpc_buffer_context * ctx =
+        (ggml_backend_rpc_buffer_context *) buffer->context;
+    rpc_msg_sync_tensor_files_rsp response = {};
+    bool status = send_rpc_cmd(
+        ctx->sock,
+        RPC_CMD_SYNC_TENSOR_FILES,
+        nullptr,
+        0,
+        &response,
+        sizeof(response));
+    RPC_STATUS_ASSERT(status);
+    LOG_DBG(
+        "[%s] completed tensors: %" PRIu64 ", bytes: %" PRIu64 "\n",
+        __func__,
+        response.completed_count,
+        response.completed_bytes);
+    return response.result != 0;
+}
