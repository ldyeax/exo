+static bool rpc_path_is_beneath(const fs::path & root, const fs::path & path) {
+    auto root_component = root.begin();
+    auto path_component = path.begin();
+    for (; root_component != root.end(); ++root_component, ++path_component) {
+        if (path_component == path.end() || *root_component != *path_component) {
+            return false;
+        }
+    }
+    return path_component != path.end();
+}
+
+bool rpc_server::queue_tensor_file(
+        const std::vector<uint8_t> & input,
+        rpc_msg_set_tensor_file_rsp & response) {
+    response.result = 0;
+    if (tensor_source_root.empty() || input.size() < sizeof(rpc_msg_set_tensor_file_req)) {
+        return true;
+    }
+
+    rpc_msg_set_tensor_file_req request;
+    memcpy(&request, input.data(), sizeof(request));
+    if (request.path_size == 0 ||
+        request.path_size > 16 * 1024 ||
+        input.size() != sizeof(request) + request.path_size ||
+        request.size == 0 ||
+        request.size > SIZE_MAX ||
+        request.tensor_offset > SIZE_MAX) {
+        return true;
+    }
+
+    std::string relative_path(
+        (const char *) input.data() + sizeof(request),
+        request.path_size);
+    if (relative_path.find('\0') != std::string::npos ||
+        relative_path.find('\\') != std::string::npos) {
+        return true;
+    }
+    fs::path relative(relative_path);
+    if (relative.empty() ||
+        relative.is_absolute() ||
+        relative.has_root_path() ||
+        relative.has_parent_path() ||
+        relative.extension() != ".gguf") {
+        return true;
+    }
+    for (const auto & component : relative) {
+        if (component.empty() || component == "." || component == "..") {
+            return true;
+        }
+    }
+
+    std::error_code path_error;
+    const fs::path unresolved_path = tensor_source_root / relative;
+    const fs::file_status unresolved_status = fs::symlink_status(unresolved_path, path_error);
+    if (path_error || fs::is_symlink(unresolved_status)) {
+        return true;
+    }
+    fs::path canonical_path = fs::canonical(unresolved_path, path_error);
+    if (path_error || !rpc_path_is_beneath(tensor_source_root, canonical_path) ||
+        !fs::is_regular_file(canonical_path, path_error) || path_error) {
+        return true;
+    }
+
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_tensor * tensor = deserialize_tensor(ctx_ptr.get(), &request.tensor);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        GGML_LOG_ERROR("[%s] error deserializing tensor\n", __func__);
+        return false;
+    }
+
+    const uint64_t tensor_size = ggml_nbytes(tensor);
+    if (request.tensor_offset > tensor_size ||
+        request.size > tensor_size - request.tensor_offset) {
+        GGML_LOG_ERROR("[%s] requested file data is outside tensor bounds\n", __func__);
+        return false;
+    }
+    const uint64_t buffer_start = (uint64_t) ggml_backend_buffer_get_base(tensor->buffer);
+    const uint64_t buffer_size = ggml_backend_buffer_get_size(tensor->buffer);
+    if (request.tensor.data < buffer_start) {
+        GGML_LOG_ERROR("[%s] tensor data is before its buffer\n", __func__);
+        return false;
+    }
+    const uint64_t data_offset = request.tensor.data - buffer_start;
+    if (data_offset > buffer_size ||
+        request.tensor_offset > buffer_size - data_offset ||
+        request.size > buffer_size - data_offset - request.tensor_offset) {
+        GGML_LOG_ERROR("[%s] requested file data is outside buffer bounds\n", __func__);
+        return false;
+    }
+
+    auto stream = std::make_unique<std::ifstream>(canonical_path, std::ios::binary);
+    if (!stream->is_open()) {
+        return true;
+    }
+    stream->seekg(0, std::ios::end);
+    const std::streamoff file_size = stream->tellg();
+    if (file_size < 0 ||
+        request.file_offset > (uint64_t) file_size ||
+        request.size > (uint64_t) file_size - request.file_offset) {
+        return true;
+    }
+    stream->seekg((std::streamoff) request.file_offset, std::ios::beg);
+    if (!*stream) {
+        return true;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(tensor_file_mutex);
+        if (tensor_file_stopping) {
+            return false;
+        }
+        tensor_file_jobs.push_back({
+            /* .tensor        = */ request.tensor,
+            /* .tensor_offset = */ request.tensor_offset,
+            /* .size          = */ request.size,
+            /* .stream        = */ std::move(stream),
+            /* .path          = */ canonical_path.string(),
+        });
+        pending_tensor_file_count++;
+    }
+    tensor_file_condition.notify_one();
+    response.result = 1;
+    return true;
+}
+
+bool rpc_server::load_tensor_file(tensor_file_job & job) {
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_tensor * tensor = deserialize_tensor(ctx_ptr.get(), &job.tensor);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        GGML_LOG_ERROR("[%s] error deserializing tensor\n", __func__);
+        return false;
+    }
+
+    constexpr size_t chunk_size = 64 * 1024 * 1024;
+    std::vector<uint8_t> staging(std::min<uint64_t>(job.size, chunk_size));
+    uint64_t completed = 0;
+    while (completed < job.size) {
+        const size_t current_size =
+            (size_t) std::min<uint64_t>(job.size - completed, staging.size());
+        void * destination = staging.data();
+        if (ggml_backend_buffer_is_host(tensor->buffer)) {
+            destination =
+                (uint8_t *) tensor->data + job.tensor_offset + completed;
+        }
+        job.stream->read((char *) destination, current_size);
+        if (job.stream->gcount() != (std::streamsize) current_size) {
+            GGML_LOG_ERROR("[%s] short read from '%s'\n", __func__, job.path.c_str());
+            return false;
+        }
+        if (!ggml_backend_buffer_is_host(tensor->buffer)) {
+            ggml_backend_tensor_set(
+                tensor,
+                staging.data(),
+                job.tensor_offset + completed,
+                current_size);
+        }
+        completed += current_size;
+    }
+    return true;
+}
+
+void rpc_server::tensor_file_worker_loop() {
+    while (true) {
+        std::optional<tensor_file_job> job;
+        {
+            std::unique_lock<std::mutex> lock(tensor_file_mutex);
+            tensor_file_condition.wait(lock, [this] {
+                return tensor_file_stopping || !tensor_file_jobs.empty();
+            });
+            if (tensor_file_jobs.empty()) {
+                if (tensor_file_stopping) {
+                    return;
+                }
+                continue;
+            }
+            job.emplace(std::move(tensor_file_jobs.front()));
+            tensor_file_jobs.pop_front();
+        }
+
+        bool loaded = false;
+        try {
+            loaded = load_tensor_file(*job);
+        } catch (const std::exception & error) {
+            GGML_LOG_ERROR("[%s] tensor file load failed: %s\n", __func__, error.what());
+        }
+
+        {
+            std::lock_guard<std::mutex> lock(tensor_file_mutex);
+            if (loaded) {
+                completed_tensor_file_count++;
+                completed_tensor_file_bytes += job->size;
+            } else {
+                tensor_file_failed = true;
+            }
+            pending_tensor_file_count--;
+        }
+        tensor_file_condition.notify_all();
+    }
+}
+
+void rpc_server::synchronize_tensor_files(rpc_msg_sync_tensor_files_rsp & response) {
+    std::unique_lock<std::mutex> lock(tensor_file_mutex);
+    tensor_file_condition.wait(lock, [this] {
+        return pending_tensor_file_count == 0;
+    });
+    response.result = tensor_file_failed ? 0 : 1;
+    response.completed_count = completed_tensor_file_count;
+    response.completed_bytes = completed_tensor_file_bytes;
+}
+
 bool rpc_server::init_tensor(const rpc_msg_init_tensor_req & request) {
     struct ggml_init_params params {
         /*.mem_size   =*/ ggml_tensor_overhead(),
@@ -1488,14 +1828,25 @@ bool rpc_server::get_device_memory(const rpc_msg_get_device_memory_req & request
