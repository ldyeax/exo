+bool llama_model_loader::prioritize_rpc_tensor_source(
+        struct ggml_context * ctx) const {
+    if (check_tensors || rpc_tensor_source_paths.empty()) {
+        return false;
+    }
+    for (ggml_tensor * tensor = ggml_get_first_tensor(ctx);
+         tensor != nullptr;
+         tensor = ggml_get_next_tensor(ctx, tensor)) {
+        const auto * weight = get_weight(ggml_get_name(tensor));
+        if (weight == nullptr ||
+            weight->idx >= rpc_tensor_source_paths.size() ||
+            rpc_tensor_source_paths[weight->idx].empty()) {
+            continue;
+        }
+        if (rpc_tensor_set_from_file(tensor->buffer) != nullptr) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void llama_model_loader::synchronize_rpc_tensor_source() {
+    for (ggml_backend_buffer_t buffer : pending_rpc_tensor_source_buffers) {
+        rpc_synchronize_tensor_files_t synchronize =
+            rpc_synchronize_tensor_files(buffer);
+        if (synchronize == nullptr || !synchronize(buffer)) {
+            throw std::runtime_error(
+                "an RPC server-local tensor load failed during synchronization");
+        }
+    }
+    if (!pending_rpc_tensor_source_buffers.empty()) {
+        LLAMA_LOG_INFO(
+            "%s: loaded %" PRIu64 " tensors (%0.2f GiB) directly from RPC server-local GGUF files\n",
+            __func__,
+            rpc_tensor_source_count,
+            rpc_tensor_source_bytes / 1024.0 / 1024.0 / 1024.0);
+    }
+    pending_rpc_tensor_source_buffers.clear();
+}
