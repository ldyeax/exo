+// situ
+
+static __global__ void situ_kernel(
+        const float * gate,
+        const float * up,
+        float * dst,
+        const int64_t k,
+        const int64_t n,
+        const int64_t gate_stride,
+        const int64_t up_stride,
+        const float beta,
+        const float linear_beta) {
+    const int64_t i = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+    if (i >= k) {
+        return;
+    }
+
+    const int64_t gate_idx = (i/n)*gate_stride + i%n;
+    const int64_t up_idx   = (i/n)*up_stride   + i%n;
+    dst[i] = ggml_cuda_op_situ_single(gate[gate_idx], up[up_idx], beta, linear_beta);
+}
+
+void ggml_cuda_op_situ(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * gate = dst->src[0];
+    const ggml_tensor * up   = dst->src[1];
+
+    GGML_ASSERT(up);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+    GGML_ASSERT(up->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous_1(gate));
+    GGML_ASSERT(ggml_is_contiguous_1(up));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(ggml_are_same_shape(gate, up));
+    GGML_ASSERT(ggml_are_same_shape(gate, dst));
+
+    const float beta        = ggml_get_op_params_f32(dst, 2);
+    const float linear_beta = ggml_get_op_params_f32(dst, 3);
+    const int64_t nelements = ggml_nelements(dst);
+    const int64_t n         = gate->ne[0];
+    const int64_t nblocks   = (nelements + CUDA_GLU_BLOCK_SIZE - 1)/CUDA_GLU_BLOCK_SIZE;
+    const ggml_cuda_kernel_launch_params launch_params(nblocks, CUDA_GLU_BLOCK_SIZE, 0, ctx.stream());
+    ggml_cuda_kernel_launch(situ_kernel, launch_params,
+        (const float *) gate->data, (const float *) up->data, (float *) dst->data,
+        nelements, n, gate->nb[1]/sizeof(float), up->nb[1]/sizeof(float), beta, linear_beta);
+}
