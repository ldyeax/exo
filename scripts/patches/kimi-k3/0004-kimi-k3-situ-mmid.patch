+// ggml_compute_forward_situ
+
+static void ggml_compute_forward_situ_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * gate = dst->src[0];
+    const ggml_tensor * up   = dst->src[1];
+
+    GGML_ASSERT(up);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+    GGML_ASSERT(up->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous_1(gate));
+    GGML_ASSERT(ggml_is_contiguous_1(up));
+    GGML_ASSERT(ggml_is_contiguous_1(dst));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int nc = gate->ne[0];
+    const int nr = ggml_nrows(gate);
+
+    GGML_ASSERT(dst->ne[0] == nc);
+    GGML_ASSERT(ggml_nrows(dst) == nr);
+
+    const float beta        = ggml_get_op_params_f32(dst, 2);
+    const float linear_beta = ggml_get_op_params_f32(dst, 3);
+
+    const int dr  = (nr + nth - 1)/nth;
+    const int ir0 = dr*ith;
+    const int ir1 = MIN(ir0 + dr, nr);
+
+    for (int ir = ir0; ir < ir1; ++ir) {
+        const float * gate_row = (const float *) ((const char *) gate->data + ir*gate->nb[1]);
+        const float * up_row   = (const float *) ((const char *) up->data   + ir*up->nb[1]);
+        float * dst_row        =       (float *) (      (char *) dst->data + ir*dst->nb[1]);
+
+        for (int i = 0; i < nc; ++i) {
+            const float gate_value = gate_row[i];
+            const float up_value   = linear_beta > 0.0f ? linear_beta*tanhf(up_row[i]/linear_beta) : up_row[i];
+            const float gate_act   = beta*tanhf(gate_value/beta)/(1.0f + expf(-gate_value));
+            dst_row[i] = gate_act*up_value;
+        }
+    }
+}
+
+static void ggml_compute_forward_situ(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            ggml_compute_forward_situ_f32(params, dst);
+            break;
+        default:
+            GGML_ABORT("fatal error");
+    }
+}
