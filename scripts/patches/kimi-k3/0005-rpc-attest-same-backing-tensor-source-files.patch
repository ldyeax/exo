+struct source_identity {
+    uint64_t inode;
+    uint64_t size;
+    int64_t  mtime_sec;
+    uint32_t mtime_nsec;
+};
+
+static source_identity identity_for(const fs::path & path) {
+    struct stat status;
+    if (stat(path.c_str(), &status) != 0) {
+        throw std::runtime_error("stat failed");
+    }
+#    if defined(__APPLE__)
+    const auto & mtime = status.st_mtimespec;
+#    else
+    const auto & mtime = status.st_mtim;
+#    endif
+    return {
+        (uint64_t) status.st_ino,
+        (uint64_t) status.st_size,
+        mtime.tv_sec,
+        (uint32_t) mtime.tv_nsec,
+    };
+}
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static size_t count_open_fds(pid_t process) {
+    const fs::path directory = fs::path("/proc") / std::to_string(process) / "fd";
+    size_t         count     = 0;
+    for (const auto & entry : fs::directory_iterator(directory)) {
+        (void) entry;
+        count++;
+    }
+    return count;
+}
+
+static bool port_is_ready(uint16_t port) {
+    const int socket_fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (socket_fd < 0) {
+        return false;
+    }
+    sockaddr_in address     = {};
+    address.sin_family      = AF_INET;
+    address.sin_port        = htons(port);
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    const bool ready        = connect(socket_fd, (sockaddr *) &address, sizeof(address)) == 0;
+    close(socket_fd);
+    return ready;
+}
+
+static uint16_t reserve_ephemeral_port() {
+    const int socket_fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (socket_fd < 0) {
+        throw std::runtime_error("socket failed");
+    }
+    sockaddr_in address     = {};
+    address.sin_family      = AF_INET;
+    address.sin_port        = 0;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    socklen_t address_size  = sizeof(address);
+    if (bind(socket_fd, (sockaddr *) &address, address_size) != 0 ||
+        getsockname(socket_fd, (sockaddr *) &address, &address_size) != 0) {
+        close(socket_fd);
+        throw std::runtime_error("ephemeral port allocation failed");
+    }
+    const uint16_t port = ntohs(address.sin_port);
+    close(socket_fd);
+    return port;
+}
+
+static pid_t start_server(const fs::path & root, const std::string & endpoint, uint16_t port) {
+    const pid_t child = fork();
+    if (child < 0) {
+        throw std::runtime_error("fork failed");
+    }
+    if (child == 0) {
+        struct rlimit descriptor_limit = { 32, 32 };
+        if (setrlimit(RLIMIT_NOFILE, &descriptor_limit) != 0) {
+            _exit(70);
+        }
+        ggml_backend_load_all();
+        ggml_backend_dev_t device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        if (device == nullptr) {
+            _exit(71);
+        }
+        ggml_backend_rpc_start_server_with_tensor_source(endpoint.c_str(), nullptr, root.c_str(), 2, 1, 1, &device);
+        _exit(72);
+    }
+    for (int attempt = 0; attempt < 200; ++attempt) {
+        if (port_is_ready(port)) {
+            return child;
+        }
+        int status = 0;
+        if (waitpid(child, &status, WNOHANG) == child) {
+            throw std::runtime_error("RPC server exited during startup");
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    kill(child, SIGKILL);
+    waitpid(child, nullptr, 0);
+    throw std::runtime_error("RPC server did not become ready");
+}
+
+struct remote_tensor {
+    ggml_context *        context = nullptr;
+    ggml_backend_buffer_t buffer  = nullptr;
+    ggml_tensor *         tensor  = nullptr;
+
+    explicit remote_tensor(ggml_backend_buffer_type_t buffer_type) {
+        ggml_init_params params = {
+            /* .mem_size   = */ ggml_tensor_overhead(),
+            /* .mem_buffer = */ nullptr,
+            /* .no_alloc   = */ true,
+        };
+        context = ggml_init(params);
+        require(context != nullptr, "context allocation failed");
+        tensor = ggml_new_tensor_1d(context, GGML_TYPE_F32, 4);
+        buffer = ggml_backend_buft_alloc_buffer(buffer_type, 64);
+        require(buffer != nullptr, "RPC buffer allocation failed");
+        tensor->buffer = buffer;
+        tensor->data   = ggml_backend_buffer_get_base(buffer);
+    }
+
+    ~remote_tensor() {
+        if (buffer != nullptr) {
+            ggml_backend_buffer_free(buffer);
+        }
+        if (context != nullptr) {
+            ggml_free(context);
+        }
+    }
+};
+
+static bool queue(remote_tensor &         destination,
+                  const std::string &     name,
+                  const source_identity & identity,
+                  bool                    strict) {
+    return ggml_backend_rpc_tensor_set_from_file(destination.tensor, name.c_str(), 0, 0,
+                                                 ggml_nbytes(destination.tensor), strict, identity.inode, identity.size,
+                                                 identity.mtime_sec, identity.mtime_nsec);
+}
+
+static void synchronize(remote_tensor & destination, uint64_t expected_count, uint64_t expected_bytes) {
+    uint64_t completed_count = 0;
+    uint64_t completed_bytes = 0;
+    require(ggml_backend_rpc_synchronize_tensor_files(destination.buffer, &completed_count, &completed_bytes),
+            "RPC tensor source barrier failed");
+    require(completed_count == expected_count, "completed count mismatch");
+    require(completed_bytes == expected_bytes, "completed bytes mismatch");
+}
+
+int main() {
+    std::array<char, 64> directory_template = {};
+    std::strcpy(directory_template.data(), "/tmp/llama-rpc-source-XXXXXX");
+    char * directory_name = mkdtemp(directory_template.data());
+    require(directory_name != nullptr, "mkdtemp failed");
+    const fs::path temporary_root(directory_name);
+    const fs::path server_root = temporary_root / "server";
+    const fs::path copied_root = temporary_root / "copy";
+    fs::create_directories(server_root);
+    fs::create_directories(copied_root);
+
+    const std::array<float, 4> first_values  = { 1.0F, 2.0F, 3.0F, 4.0F };
+    const std::array<float, 4> second_values = { 5.0F, 6.0F, 7.0F, 8.0F };
+    for (const auto & [name, values] : std::array{
+             std::pair{ "first.gguf",  first_values  },
+             std::pair{ "second.gguf", second_values },
+             std::pair{ "third.gguf",  first_values  },
+    }) {
+        std::ofstream output(server_root / name, std::ios::binary);
+        output.write((const char *) values.data(), sizeof(values));
+    }
+    fs::copy_file(server_root / "first.gguf", copied_root / "first.gguf");
+
+    const uint16_t    port     = reserve_ephemeral_port();
+    const std::string endpoint = "127.0.0.1:" + std::to_string(port);
+    pid_t             server   = -1;
+    try {
+        server                                 = start_server(server_root, endpoint, port);
+        ggml_backend_buffer_type_t buffer_type = ggml_backend_rpc_buffer_type(endpoint.c_str(), 0);
+        require(buffer_type != nullptr, "RPC buffer type unavailable");
+
+        {
+            remote_tensor         first(buffer_type);
+            remote_tensor         second(buffer_type);
+            const source_identity first_identity  = identity_for(server_root / "first.gguf");
+            const source_identity copied_identity = identity_for(copied_root / "first.gguf");
+            const source_identity second_identity = identity_for(server_root / "second.gguf");
+            const source_identity third_identity  = identity_for(server_root / "third.gguf");
+            require(first_identity.inode != copied_identity.inode, "copy unexpectedly shares inode");
+
+            const size_t baseline_fds = count_open_fds(server);
+            require(queue(first, "first.gguf", first_identity, true), "strict source was rejected");
+            for (int repeat = 0; repeat < 256; ++repeat) {
+                require(queue(first, "first.gguf", first_identity, true), "repeated source was rejected");
+            }
+            synchronize(first, 257, 257 * sizeof(first_values));
+            const size_t one_source_fds = count_open_fds(server);
+            require(one_source_fds == baseline_fds + 1, "one shard did not consume exactly one FD");
+
+            std::array<float, 4> loaded = {};
+            ggml_backend_tensor_get(first.tensor, loaded.data(), 0, sizeof(loaded));
+            require(loaded == first_values, "server-local tensor bytes differ");
+
+            require(!queue(second, "first.gguf", copied_identity, true),
+                    "same-size copied shard passed same-backing-file attestation");
+            require(queue(second, "first.gguf", copied_identity, false),
+                    "explicit fallback mode did not preserve compatibility");
+            synchronize(second, 1, sizeof(first_values));
+
+            require(queue(second, "second.gguf", second_identity, true), "second shard was rejected");
+            synchronize(second, 2, sizeof(first_values) + sizeof(second_values));
+            const size_t two_source_fds = count_open_fds(server);
+            require(two_source_fds == baseline_fds + 2, "two shards did not consume exactly two FDs");
+
+            require(!queue(second, "third.gguf", third_identity, true),
+                    "configured shard FD cap admitted a third file");
+            require(count_open_fds(server) == two_source_fds, "rejected shard leaked a file descriptor");
+
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+            {
+                std::ofstream changed(server_root / "first.gguf", std::ios::binary);
+                changed.write((const char *) second_values.data(), sizeof(second_values));
+            }
+            uint64_t ignored_count = 0;
+            uint64_t ignored_bytes = 0;
+            require(!ggml_backend_rpc_synchronize_tensor_files(first.buffer, &ignored_count, &ignored_bytes),
+                    "barrier accepted a source modified while held open");
+        }
+
+        kill(server, SIGTERM);
+        waitpid(server, nullptr, 0);
+        server = -1;
+        fs::remove_all(temporary_root);
+        return 0;
+    } catch (...) {
+        if (server > 0) {
+            kill(server, SIGKILL);
+            waitpid(server, nullptr, 0);
+        }
+        fs::remove_all(temporary_root);
+        throw;
+    }
+}
+#else
+int main() {
+    return 0;
+}
+#endif
