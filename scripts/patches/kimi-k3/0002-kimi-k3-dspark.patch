+@ModelBase.register("K3DSparkModel")
+class K3DSparkModel(DFlashModel):
+    model_arch = gguf.MODEL_ARCH.DFLASH
+
+    def set_vocab(self):
+        super().set_vocab()
+        self.gguf_writer.add_mask_token_id(self.hparams["mask_token_id"])
+
+    def set_gguf_parameters(self):
+        if self.hparams.get("markov_head_type") != "vanilla":
+            raise ValueError("K3 DSpark requires the vanilla Markov head")
+        if self.hparams.get("draft_vocab_size") != self.hparams.get("vocab_size"):
+            raise ValueError("K3 DSpark requires draft_vocab_size == vocab_size")
+        if self.hparams.get("mla_use_nope") or self.hparams.get("mla_use_output_gate"):
+            raise ValueError("K3 DSpark requires RoPE MLA without an output gate")
+        if self.hparams.get("sample_from_anchor", True) is not True:
+            raise ValueError("K3 DSpark requires anchor-as-first-prediction layout")
+
+        self.hparams["num_key_value_heads"] = 1
+        TextModel.set_gguf_parameters(self)
+
+        self.gguf_writer.add_vocab_size(self.hparams["vocab_size"])
+        self.gguf_writer.add_rope_dimension_count(self.hparams["qk_rope_head_dim"])
+        self.gguf_writer.add_q_lora_rank(self.hparams["q_lora_rank"])
+        self.gguf_writer.add_kv_lora_rank(self.hparams["kv_lora_rank"])
+        self.gguf_writer.add_key_length(self.hparams["kv_lora_rank"] + self.hparams["qk_rope_head_dim"])
+        self.gguf_writer.add_value_length(self.hparams["kv_lora_rank"])
+        self.gguf_writer.add_key_length_mla(self.hparams["qk_nope_head_dim"] + self.hparams["qk_rope_head_dim"])
+        self.gguf_writer.add_value_length_mla(self.hparams["v_head_dim"])
+        self.gguf_writer.add_causal_attention(False)
+
+        target_layer_ids = self.hparams["target_layer_ids"]
+        if len(target_layer_ids) != self.hparams["num_target_layers"]:
+            raise ValueError("K3 DSpark target layer count does not match target_layer_ids")
+        if self.hparams["target_hidden_size"] != self.hparams["hidden_size"]:
+            raise ValueError("K3 DSpark target and draft hidden sizes must match")
+        self.gguf_writer.add_target_layers([il + 1 for il in target_layer_ids])
+
+        # K3 uses anchor-as-first-prediction: all seven query rows are predictions.
+        self.gguf_writer.add_block_size(7)
+        self.gguf_writer.add_uint32(
+            f"{self.gguf_writer.arch}.markov_rank",
+            self.hparams["markov_rank"],
+        )
+
+        if (mscale_all_dim := self.rope_parameters.get("mscale_all_dim")) is not None:
+            self.gguf_writer.add_rope_scaling_yarn_log_mul(0.1 * mscale_all_dim)
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        name, _ = item
+        if name.startswith(("confidence_head.", "embed_tokens.")):
+            return None
+        return TextModel.filter_tensors(item)
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if name == "context_proj.weight":
+            name = "model.fc.weight"
+        elif name == "context_norm.weight":
+            name = "model.hidden_norm.weight"
+        elif name == "final_norm.weight":
+            name = "model.norm.weight"
+        elif name == "markov_head.markov_w1.weight":
+            yield "markov_w1.weight", data_torch
+            return
+        elif name == "markov_head.markov_w2.weight":
+            yield "markov_w2.weight", data_torch
+            return
+        elif name.startswith("layers."):
+            name = "model." + name
+
+        if name.endswith("kv_b_proj.weight"):
+            n_head = self.hparams["num_attention_heads"]
+            v_head_dim = self.hparams["v_head_dim"]
+            qk_nope_head_dim = self.hparams["qk_nope_head_dim"]
+            if data_torch.shape[0] != n_head * (v_head_dim + qk_nope_head_dim):
+                raise ValueError(f"unexpected K3 DSpark kv_b shape {tuple(data_torch.shape)}")
+            kv_b = data_torch.view(n_head, v_head_dim + qk_nope_head_dim, data_torch.shape[-1])
+            k_b, v_b = torch.split(kv_b, [qk_nope_head_dim, v_head_dim], dim=1)
+            k_b = k_b.transpose(1, 2)
+            yield from TextModel.modify_tensors(
+                self, k_b, name.replace("kv_b_proj", "k_b_proj"), bid)
+            yield from TextModel.modify_tensors(
+                self, v_b, name.replace("kv_b_proj", "v_b_proj"), bid)
+            return
+
+        yield from TextModel.modify_tensors(self, data_torch, name, bid)
