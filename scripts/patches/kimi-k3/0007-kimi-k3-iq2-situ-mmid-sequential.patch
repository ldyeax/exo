+// Kimi K3 batch-one SiTU specialization. The generic paired-MMID epilogue keeps
+// both projections' per-row accumulators live at once. That is especially
+// expensive for IQ2_XS on SM86, where the ordinary MMVQ kernel uses the
+// small-K four-row schedule. Compute the gate and up projections in two phases
+// instead, reusing the same accumulator and inter-warp scratch storage. Only
+// the four reduced gate scalars survive across phases.
+template <ggml_type type, int c_nwarps, int c_rows_per_block>
+__launch_bounds__(c_nwarps*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_moe_situ_sequential(
+        const void * up_ptr, const void * gate_ptr, const void * vy_ptr, const int32_t * ids_ptr,
+        float * dst_ptr, const uint32_t ncols_x, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_dst, const float beta, const float linear_beta) {
+    const void    * GGML_CUDA_RESTRICT up   = up_ptr;
+    const void    * GGML_CUDA_RESTRICT gate = gate_ptr;
+    const void    * GGML_CUDA_RESTRICT vy   = vy_ptr;
+    const int32_t * GGML_CUDA_RESTRICT ids  = ids_ptr;
+    float         * GGML_CUDA_RESTRICT dst  = dst_ptr;
+
+    constexpr int qk        = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi        = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr       = get_vdr_mmvq(type);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    __shared__ float partials[c_nwarps > 1 ? c_nwarps - 1 : 1][c_rows_per_block][warp_size];
+    __shared__ float gate_values[c_rows_per_block];
+
+    const int tid = warp_size * threadIdx.y + threadIdx.x;
+    const int row0 = c_rows_per_block * blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * c_nwarps * warp_size / qi;
+
+    ggml_cuda_pdl_sync();
+
+    const uint32_t channel_x = ids[blockIdx.y];
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = channel_x * stride_channel_x + row0 * stride_row_x;
+
+    float dot[c_rows_per_block] = { 0.0f };
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+            dot[row] += vec_dot_q_cuda(
+                gate, &y[kby], kbx_offset + row * stride_row_x + kbx, kqs);
+        }
+    }
+
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+            partials[threadIdx.y - 1][row][threadIdx.x] = dot[row];
+        }
+    }
+    __syncthreads();
+
+    if (threadIdx.y == 0) {
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+#pragma unroll
+            for (int warp = 0; warp < c_nwarps - 1; ++warp) {
+                dot[row] += partials[warp][row][threadIdx.x];
+            }
+            dot[row] = warp_reduce_sum<warp_size>(dot[row]);
+        }
+        if (threadIdx.x < c_rows_per_block && row0 + threadIdx.x < nrows_x) {
+            gate_values[threadIdx.x] = dot[threadIdx.x];
+        }
+    }
+    __syncthreads();
+
+#pragma unroll
+    for (int row = 0; row < c_rows_per_block; ++row) {
+        dot[row] = 0.0f;
+    }
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+            dot[row] += vec_dot_q_cuda(
+                up, &y[kby], kbx_offset + row * stride_row_x + kbx, kqs);
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+            partials[threadIdx.y - 1][row][threadIdx.x] = dot[row];
+        }
+    }
+    __syncthreads();
+
+    if (threadIdx.y == 0) {
+#pragma unroll
+        for (int row = 0; row < c_rows_per_block; ++row) {
+#pragma unroll
+            for (int warp = 0; warp < c_nwarps - 1; ++warp) {
+                dot[row] += partials[warp][row][threadIdx.x];
+            }
+            dot[row] = warp_reduce_sum<warp_size>(dot[row]);
+        }
+        if (threadIdx.x < c_rows_per_block && row0 + threadIdx.x < nrows_x) {
+            const int row = threadIdx.x;
+            dst[blockIdx.y * stride_channel_dst + row0 + row] =
+                ggml_cuda_op_situ_single(gate_values[row], dot[row], beta, linear_beta);
+        }
+    }
+}
