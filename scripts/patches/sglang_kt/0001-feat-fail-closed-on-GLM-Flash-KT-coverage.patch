+
+    def tearDown(self):
+        registry._QUANT_WRAPPERS[:] = self.original_wrappers
+
+    def test_registration_query_and_requirement(self):
+        registry._QUANT_WRAPPERS.clear()
+        registry.register_moe_quant_wrapper(
