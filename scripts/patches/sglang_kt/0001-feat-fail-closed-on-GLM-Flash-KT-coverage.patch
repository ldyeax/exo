+            patch.object(kt.dist, "broadcast", broadcast),
+            patch.object(kt, "get_tp_group", return_value=group),
+        ):
+            kt._broadcast_tp_tensor(tensor, on_device=True)
+
+        broadcast.assert_called_once_with(
+            tensor,
+            src=2,
+            group=group.device_group,
+        )
+
